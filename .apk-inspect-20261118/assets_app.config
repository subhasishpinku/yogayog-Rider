{"name":"BA e-Mart","slug":"ba-emart","scheme":"bamart","version":"2.2.33","orientation":"portrait","icon":"./assets/icon.png","userInterfaceStyle":"light","backgroundColor":"#16A34A","primaryColor":"#16A34A","ios":{"supportsTablet":true,"bundleIdentifier":"com.bamart.app"},"android":{"package":"com.bamart.app","versionCode":37,"adaptiveIcon":{"backgroundImage":"./assets/android-icon-background.png","foregroundImage":"./assets/android-icon-foreground.png","monochromeImage":"./assets/android-icon-monochrome.png","backgroundColor":"#16A34A"},"blockedPermissions":["android.permission.RECORD_AUDIO","android.permission.SYSTEM_ALERT_WINDOW","android.permission.READ_EXTERNAL_STORAGE","android.permission.WRITE_EXTERNAL_STORAGE"],"permissions":["android.permission.ACCESS_COARSE_LOCATION","android.permission.ACCESS_FINE_LOCATION","android.permission.RECORD_AUDIO"]},"web":{"favicon":"./assets/favicon.png"},"plugins":[["expo-splash-screen",{"backgroundColor":"#03963A","image":"./assets/splash-icon.png","imageWidth":120}],["expo-build-properties",{"android":{"enableMinifyInReleaseBuilds":true,"enableShrinkResourcesInReleaseBuilds":true,"buildArchs":["armeabi-v7a","arm64-v8a","x86_64"]}}],["expo-location",{"locationWhenInUsePermission":"BA e-Mart uses your location to show delivery availability and nearby service zones."}],["expo-image-picker",{"photosPermission":"BA e-Mart needs access to your photos to upload KYC documents and your profile picture.","cameraPermission":"BA e-Mart needs the camera to capture KYC documents and your profile picture."}],"expo-font","./plugins/withAndroidRelease","expo-web-browser",["expo-notifications",{"icon":"./assets/android-icon-monochrome.png","color":"#16A34A","defaultChannel":"default"}]],"sdkVersion":"58.0.0","platforms":["ios","android","web"],"extra":{}}