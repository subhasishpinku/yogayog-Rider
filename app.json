{
  "expo": {
    "name": "YogaYog-Rider",
    "slug": "yogayog-rider",
    "version": "1.0.0",
    "jsEngine": "hermes",
    "orientation": "portrait",
    "icon": "./assets/yogayoglogo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yogayog.rider",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/yogayoglogo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.yogayog.rider",
      "googleMapsApiKey": "AIzaSyBzySPQYl8UIK_7Rb-EQkHkRrV3_sO74Gs",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyBzySPQYl8UIK_7Rb-EQkHkRrV3_sO74Gs",
          "iosGoogleMapsApiKey": "AIzaSyBzySPQYl8UIK_7Rb-EQkHkRrV3_sO74Gs"
        }
      ],
      "./plugins/withNoNativeSplash",
      "@react-native-community/datetimepicker",
      [
        "expo-ocr-kit",
        {
          "cameraPermission": "Allow YogaYog Rider to capture document images for OCR verification."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow YogaYog Rider to access your location.",
          "locationAlwaysAndWhenInUsePermission": "Allow YogaYog Rider to track delivery location in the background.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "979defe4-3256-4544-ac3e-31e4d40b4fe5"
      }
    },
    "owner": "subhasish_singha"
  }
}
