{
  "expo": {
    "name": "YogaYog-Rider",
    "slug": "yogayog-rider",
    "version": "1.0.0",
    "jsEngine": "hermes",
    "orientation": "portrait",
    "icon": "./assets/yogayoglogo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/yogayoglogo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.yogayog.rider",
      "googleMapsApiKey": "AIzaSyBzySPQYl8UIK_7Rb-EQkHkRrV3_sO74Gs"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyBzySPQYl8UIK_7Rb-EQkHkRrV3_sO74Gs",
          "iosGoogleMapsApiKey": "AIzaSyBzySPQYl8UIK_7Rb-EQkHkRrV3_sO74Gs"
        }
      ],
      "expo-location",
      "./plugins/withNoNativeSplash",
      "@react-native-community/datetimepicker",
      [
        "expo-ocr-kit",
        {
          "cameraPermission": "Allow YogaYog Rider to capture document images for OCR verification."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "26156609-8bd6-4c3f-b78b-ab3d840e518b"
      }
    },
    "owner": "lokeash_agarwal"
  }
}
